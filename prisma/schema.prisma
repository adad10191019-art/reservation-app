// 予約管理システム スキーマ
//
// 設計方針（設計メモより）
//  - 時刻は「0時からの経過分」の整数で持つ（10:00 = 600）
//  - 日付は "YYYY-MM-DD" の文字列で持つ（タイムゾーン由来のズレを避けるため）
//  - 全テーブルに tenantId を持たせる（マルチテナント）
//  - 予約は消さず status を変える（論理削除）
//  - 列挙は String + コメントで表現する

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── 店舗 ───────────────────────────────
model Tenant {
  id   String  @id @default(uuid())
  name String
  /// お客様向けURLに使う短い名前。未設定なら店舗IDを使う
  slug String? @unique

  timezone    String @default("Asia/Tokyo")
  slotMinutes Int    @default(15) // 予約枠の刻み（分）

  // お客様向けの予約受付の条件
  bookingWindowDays  Int @default(30) // 何日先まで予約を受けるか
  bookingLeadMinutes Int @default(120) // 開始の何分前まで受けるか

  /// 店舗ごとのLINE連携。空なら環境変数（システム全体の既定値）を使う。
  /// 複数の公式LINEアカウントをテナントごとに使い分けるための項目。
  lineLoginChannelId       String?
  lineLoginChannelSecret   String?
  lineMessagingAccessToken String?

  /// お客様のログイン方法。"line" | "email" | "both" | null（null=自動：
  /// LINEが使えればLINE、使えなければメール）
  customerLoginMethod String?

  /// LINEアプリの中で予約ページを開くためのLIFFアプリID。
  /// 空なら環境変数（NEXT_PUBLIC_LIFF_ID）をシステム全体の既定値として使う。
  /// LINEログインと同じチャネルの中に登録する（新しいチャネルではない）
  liffId String?

  /// お客様向け予約ページのブランドカラー（"#1F2A44" のような16進数）。
  /// 空なら既定の色を使う。クライアントごとに予約ページの差し色を変えられるようにする
  brandColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  staffs             Staff[]
  menus              Menu[]
  staffMenus         StaffMenu[]
  businessHours      BusinessHour[]
  dateOverrides      DateOverride[]
  customers          Customer[]
  reservations       Reservation[]
  blocks             Block[]
  changeLogs         ChangeLog[]
  customerLoginCodes CustomerLoginCode[]
}

// ── ログインする人 ─────────────────────
// 1人1アカウント。兼任の人も同じアカウントで、担当する部署（Membership）を切り替えて使う。
// 担当部署が1つも無い人は「全体スケジュール」だけを使う社員（名簿の人に必ずひも付く）。
model User {
  id                 String   @id @default(uuid())
  /// ログインID。システム全体で1つだけ（ログインはメールで探すため）
  email              String   @unique
  passwordHash       String
  /// true なら全部署を横断できる全社管理者
  isGroupAdmin       Boolean  @default(false)
  /// 名簿のどの人か。担当部署の無い社員は必須（「全体スケジュール」の自分の列を決めるため）
  employeeId         String?  @unique
  /// 発行したまま（初期パスワード＝メールアドレス）の間は true。最初のログインで変えてもらう
  mustChangePassword Boolean  @default(false)
  /// 最後に選んでいた部署。次にログインしたときはここを開く
  lastTenantId       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee    Employee?    @relation(fields: [employeeId], references: [id])
  memberships Membership[]
}

// ── 担当部署（アカウント × 部署） ─────────
// 役割（オーナー／スタッフ）は部署ごとに持つ（イロハではオーナー、不動産ではスタッフ、もありうる）。
model Membership {
  id         String   @id @default(uuid())
  userId     String
  tenantId   String
  role       String // "owner" | "staff"
  /// この部署で予約を受けるスタッフ。オーナーは空でもよい
  staffId    String?  @unique
  /// 通知の受け取りに使うLINE利用者ID。LINE のIDは部署のLINEチャネルごとに違うので、部署ごとに持つ
  lineUserId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff? @relation(fields: [staffId], references: [id])

  @@unique([userId, tenantId])
  @@unique([tenantId, lineUserId])
  @@index([tenantId])
}

/**
 * ログイン失敗の記録（総当たり攻撃対策）。
 * メールアドレスは部署ごとに重複しうるが、ログイン試行者はどの部署の
 * アカウントか知らずに試すので、ここでは入力されたメールアドレスの
 * 文字列そのものをキーにして、部署をまたいでまとめて数える。
 */
model LoginAttempt {
  email       String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ── スタッフ ───────────────────────────
model Staff {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  isActive     Boolean  @default(true) // 退職しても過去の予約を残すため削除しない
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Googleカレンダー等から購読するための、予定を推測できない長さのランダムな合言葉。
  // ログイン無しでURLだけを鍵にするため、漏れたら再発行して失効させる
  calendarToken String? @unique

  /// 会社全体の社員名簿のどの人か。兼任なら、複数の部署のスタッフが同じ社員を指す。
  /// 空ならまだ名簿とひも付けていない（その部署の中だけで今まで通り動く）
  employeeId String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  membership    Membership?
  staffMenus    StaffMenu[]
  businessHours BusinessHour[]
  dateOverrides DateOverride[]
  reservations  Reservation[]
  blocks        Block[]

  @@index([tenantId])
  @@index([employeeId])
}

// ── 社員名簿（会社全体） ─────────────────
// 部署（Tenant）の上に置く、会社全体で1つの名簿。社員1人につき1行。
// 部署のスタッフはここにひも付く（兼任なら複数の部署のスタッフが同じ社員を指す）。
// 予約を受けない社員（事務など）は、スタッフを持たず名簿だけに載る。
//
// 全社管理者（group_admin）が全部署を横断するのと同じく、
// このシステム1つ＝会社1つという前提で、tenantId を持たない。
model Employee {
  id           String   @id @default(uuid())
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true) // 退職しても過去の予定を残すため削除しない
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffs                   Staff[]
  events                   EmployeeEvent[]
  /// この人のログイン（1人1つ）
  user                     User?
  /// この人の Google カレンダー（1人1つ。どの部署の空き枠にも効く）
  googleCalendarConnection GoogleCalendarConnection?
  googleEventCaches        GoogleEventCache[]
}

// ── 社員の予定（人に付く予定） ───────────
// どの部署から入れても、その人がスタッフとして属する全部署の空き枠で
// 「空いていない時間」になる。部署のブロック枠（Block）は部署の中の道具、
// こちらは人そのものの予定、という分け方。
model EmployeeEvent {
  id            String   @id @default(uuid())
  employeeId    String
  date          String // "YYYY-MM-DD"
  startMinutes  Int
  endMinutes    Int
  title         String
  /// true なら本人以外には件名を出さず「予定あり」とだけ見せる
  isPrivate     Boolean  @default(false)
  /// 誰が入れたか（本人か、管理者の代理入力か）。消えても分かるよう表示名を複製して残す
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
  @@index([date])
}

// ── Googleカレンダーとの双方向連携 ─────
// 本人のGoogleカレンダーにある予定を取り込んで、空き枠の計算と全体スケジュールに反映させる。
// （アプリ→カレンダーは既存の calendarToken によるURL購読が別にある）
// 連携は人（社員名簿）に付く。兼任でも1回つなげば全部署の空き枠に効き、部署に属さない人もつなげる。
model GoogleCalendarConnection {
  employeeId           String    @id
  /// 画面に表示するだけの情報（本人確認用）
  googleEmail          String
  /// 有効期限が無く、明示的に取り消されるまで使い続けられる
  refreshToken         String
  /// 直近取得したアクセストークン。期限内は使い回し、Google側への呼び出しを減らす
  accessToken          String?
  accessTokenExpiresAt DateTime?
  /// 全体スケジュールに件名を出すか。出さないときは「予定あり」だけ（本人が選ぶ）
  showTitles           Boolean   @default(false)
  /// Google が許可を無効と返した（取り消された・期限が切れた）時刻。以後は問い合わせず、
  /// 本人と全体スケジュールに「つなぎ直してください」と出す。つなぎ直すと消える
  brokenAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// 全体スケジュールに出す Google の予定を、人・日付ごとに少しの間だけ覚えておく。
// 数十人ぶんを開くたびに Google へ問い合わせると遅くなるため（google-calendar-cache.ts）。
// 空き枠の計算はここを使わず、毎回その場で Google に確かめる。
model GoogleEventCache {
  employeeId String
  date       String // "YYYY-MM-DD"
  /// [{ start, end, title }]。title は件名を出さない設定なら null
  items      Json
  fetchedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, date])
}

// ── メニュー ───────────────────────────
model Menu {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  durationMinutes Int // 所要時間
  bufferMinutes   Int      @default(0) // 片付け時間
  price           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  staffMenus   StaffMenu[]
  reservations Reservation[]

  @@index([tenantId])
}

// ── 誰がどのメニューをできるか ─────────
model StaffMenu {
  tenantId String
  staffId  String
  menuId   String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([staffId, menuId])
  @@index([tenantId])
  @@index([menuId])
}

// ── 営業時間の基本パターン ─────────────
model BusinessHour {
  id           String  @id @default(uuid())
  tenantId     String
  staffId      String? // null なら店舗全体の営業時間
  dayOfWeek    Int // 0=日曜 〜 6=土曜
  startMinutes Int // 10:00 → 600
  endMinutes   Int // 19:00 → 1140

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // 昼休憩は 10:00-13:00 / 14:00-19:00 の2行で表現する
  @@index([tenantId, dayOfWeek])
  @@index([staffId])
}

// ── 日付ごとの例外 ─────────────────────
model DateOverride {
  id           String  @id @default(uuid())
  tenantId     String
  staffId      String? // null なら店舗全体
  date         String // "YYYY-MM-DD"
  isClosed     Boolean @default(false) // true なら終日休み
  startMinutes Int?
  endMinutes   Int?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([staffId])
}

// ── ブロック枠（予約以外で時間を塞ぐ） ──
// 会議・清掃・研修など、予約ではないが枠を埋めたい予定。
// ダミーの予約で代用すると売上集計に混ざるため、別のテーブルにする。
model Block {
  id           String   @id @default(uuid())
  tenantId     String
  staffId      String? // null なら店舗全体（全スタッフを塞ぐ）
  date         String // "YYYY-MM-DD"
  startMinutes Int
  endMinutes   Int
  reason       String // 会議、清掃、研修 など
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([staffId, date])
}

// ── 変更履歴 ─────────────────────────────
// ブロック枠・日付ごとの勤務時間は、本人（スタッフ）も自分の分だけ
// 作成・削除できるようにする。誤って消したときに追えるよう、
// 誰が・いつ・何をしたかをここに残す。行は消さず残し続ける。
model ChangeLog {
  id        String   @id @default(uuid())
  tenantId  String
  /// 消えても分かるよう、操作した時点の表示名をそのまま複製して残す
  actorName String
  /// "block" | "dateOverride"
  entity    String
  /// "created" | "deleted"
  action    String
  /// 画面にそのまま出す説明文（例: "9/24 14:00-15:00 会議 を追加"）
  summary   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

// ── お客様のメールログイン用ワンタイムコード ──
// メールアドレスの本人確認だけを目的にした使い捨てコード。
// 認証（成功・期限切れ）のたびに消し、使い回されないようにする。
model CustomerLoginCode {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  /// 平文のコードは保存しない（HMACでハッシュ化した値だけ持つ）
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, email])
}

// ── 顧客 ───────────────────────────────
model Customer {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  phone           String?
  email           String?
  lineUserId      String? // LINEログインで得られる利用者ID
  /// LINE の表示名。ログインのたびに最新に追従する（name は上書きしない）
  lineDisplayName String?
  /// お客様が自分で名前を入力した日時。空なら name は LINE の表示名のまま
  nameEnteredAt   DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  reservations Reservation[]

  // 同じ人が同じ店舗で二重に作られないようにする
  @@unique([tenantId, lineUserId])
  @@index([tenantId])
}

// ── 予約（中心） ───────────────────────
model Reservation {
  id         String @id @default(uuid())
  tenantId   String
  staffId    String
  customerId String
  menuId     String

  date         String // "YYYY-MM-DD"
  startMinutes Int
  endMinutes   Int // buffer を含んだ「枠を塞ぐ時間」

  // 予約時点の値をコピーして保存する。
  // 参照だけにすると、後でメニューを変更したときに過去の予約まで変わってしまう。
  menuNameSnapshot String
  durationSnapshot Int
  priceSnapshot    Int

  status         String    @default("booked") // "booked" | "done" | "canceled" | "no_show"
  canceledAt     DateTime?
  /// 日時・担当を変更した日時。カレンダーで「直前に移動した」印を出すために使う
  movedAt        DateTime?
  /// 前日リマインドを送った日時。二重送信を防ぐために使う
  reminderSentAt DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  menu     Menu     @relation(fields: [menuId], references: [id])

  // 空き枠検索で最も多く使う組み合わせ
  @@index([tenantId, date, staffId])
  @@index([tenantId, customerId])
  @@index([staffId, date])
}
