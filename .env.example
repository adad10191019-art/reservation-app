# PostgreSQL（Neon）。手元の開発も公開先も同じ1つのDBを指す
# （このプロジェクトでは、開発用と本番用のDBを分けていない）
DATABASE_URL="postgresql://ユーザー名:パスワード@ホスト:5432/データベース名?sslmode=require"

# DIRECT_URL … 構造の変更（マイグレーション）に使う直接接続。
# Neon のようにプール経由の接続を配るサービスでは、プールを通さないURLをここに入れる。
# prisma7.config.ts がこちらを優先して使う。未設定なら DATABASE_URL を使う。
DIRECT_URL="postgresql://ユーザー名:パスワード@ホスト:5432/データベース名?sslmode=require"

# セッションの署名に使う秘密鍵（16文字以上）
# 次のコマンドで作れる:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ここに長いランダム文字列"

# 公開するときのURL（LINEログインの戻り先に使う）
APP_URL="http://localhost:3000"

# LINEログイン（LINE Developers でチャネルを作ると発行される）
# 未設定の間は、開発用の仮ログインに切り替わる（本番では動かない）
# LINE_LOGIN_CHANNEL_ID=""
# LINE_LOGIN_CHANNEL_SECRET=""

# LINE公式アカウントからの通知（Messaging API のチャネルアクセストークン）
# 未設定の間は送信せず、内容をログに出すだけになる
# ※ LINEログインのチャネルと同じプロバイダーに置くこと。
#    別プロバイダーだと利用者IDが一致せず、通知を送れない
# LINE_MESSAGING_ACCESS_TOKEN=""

# 店舗側への通知メール（Resend）。LINE連携がまだのスタッフ・オーナーには、
# ログイン用のメールアドレス宛にこちらで送る。どちらか未設定の間は送信せず、
# 内容をログに出すだけになる
# RESEND_API_KEY=""
# EMAIL_FROM="予約管理システム <notify@your-domain.example>"
