# 手元での開発（SQLite）
DATABASE_URL="file:./dev.db"

# 公開するとき（PostgreSQL）
# 下を有効にして、prisma/schema.prisma の provider も "postgresql" に変える。
# 詳しい手順は README の「PostgreSQL へ切り替える」を参照。
# DATABASE_URL="postgresql://ユーザー名:パスワード@ホスト:5432/データベース名?sslmode=require"

# セッションの署名に使う秘密鍵（16文字以上）
# 次のコマンドで作れる:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ここに長いランダム文字列"

# 公開するときのURL（LINEログインの戻り先に使う）
APP_URL="http://localhost:3000"

# LINEログイン（LINE Developers でチャネルを作ると発行される）
# 未設定の間は、開発用の仮ログインに切り替わる（本番では動かない）
# LINE_LOGIN_CHANNEL_ID=""
# LINE_LOGIN_CHANNEL_SECRET=""
